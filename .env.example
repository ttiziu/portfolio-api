NODE_ENV=production
PORT=7700
CORS_ORIGINS=https://jherry.me,https://www.jherry.me

# Copy this file to the server as .env — never commit the filled copy.
# Server only — never NEXT_PUBLIC
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Resend — contact form. Sending access key. Server only.
RESEND_API_KEY=
# Optional. Defaults: Jherry <contact@jherry.me> → contact@jherry.me
# RESEND_FROM=Jherry <contact@jherry.me>
# RESEND_TO=contact@jherry.me
